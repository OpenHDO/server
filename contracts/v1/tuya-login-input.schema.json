{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "default": "Tuya",
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "user_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "User Code",
      "type": "string"
    },
    "integration_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integration Id"
    }
  },
  "required": [
    "user_code"
  ],
  "title": "TuyaLoginInput",
  "type": "object"
}
