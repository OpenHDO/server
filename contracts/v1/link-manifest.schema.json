{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhdo.org/schemas/v1/link-manifest.schema.json",
  "title": "OpenHDO Linker manifest",
  "description": "Linker identity and optional vendor-neutral device capability discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "transports"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,31}$"
      },
      "uniqueItems": true
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "capabilities"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "light-capability.schema.json"
            }
          }
        }
      },
      "description": "Optional discovered devices and their abstract capabilities."
    }
  }
}
